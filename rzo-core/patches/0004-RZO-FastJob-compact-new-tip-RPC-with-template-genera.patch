+
+    std::optional<interfaces::RZOFastMiningJob> getPreparedMiningJob(
+        const uint256& tip,
+        MillisecondsDouble timeout) override
+    {
+        const auto wait_start{std::chrono::steady_clock::now()};
+
+        std::unique_lock<std::mutex> lock{m_fasttemplate_cache_mutex};
+
+        if (!m_fasttemplate_started) {
+            return std::nullopt;
+        }
+
+        const bool ready{
+            m_fasttemplate_cache_cv.wait_for(
+                lock,
+                std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                    timeout),
+                [this, &tip] {
+                    return m_fastjob_prepared &&
+                           m_fastjob_prepared->header.hashPrevBlock == tip;
+                })};
+
+        if (!ready ||
+            !m_fastjob_prepared ||
+            m_fastjob_prepared->header.hashPrevBlock != tip) {
+            return std::nullopt;
+        }
+
+        // Non-destructive read. The job remains available for RPC retries
+        // until the worker replaces it with the next tip's snapshot.
+        std::optional<interfaces::RZOFastMiningJob> job{
+            *m_fastjob_prepared};
+
+        lock.unlock();
+
+        const int64_t wait_us{
+            std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - wait_start)
+                .count()};
+
+        LogInfo(
+            "[RZO-FastJob] cache hit "
+            "tip=%s wait_us=%d\n",
+            tip.ToString(),
+            wait_us);
+
+        return job;
     }
 
     void interrupt() override
