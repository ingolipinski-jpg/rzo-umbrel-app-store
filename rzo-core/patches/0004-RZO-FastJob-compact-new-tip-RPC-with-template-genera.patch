+/**
+ * RZO new-tip fast mining job.
+ *
+ * Contains only the information a Stratum server needs to construct
+ * coinbase work and mining.notify. No full transaction serialization
+ * is carried on this path.
+ */
+struct RZOFastMiningJob
+{
+    // Process-local monotonically increasing identifier for this exact
+    // prepared mining template. A node restart intentionally resets it.
+    uint64_t template_id{0};
+
+    // Header fields produced by the exact prepared CBlockTemplate.
+    CBlockHeader header;
+
+    // Height of the block being mined.
+    int height{0};
