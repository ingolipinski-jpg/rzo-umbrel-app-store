+
+static std::unique_ptr<UniValue> RZOBuildPreparedTransactions(
+    const std::vector<CTransactionRef>& block_transactions,
+    const std::vector<CAmount>& tx_fees,
+    const std::vector<int64_t>& tx_sigops)
+{
+    auto transactions{std::make_unique<UniValue>(UniValue::VARR)};
+
+    if (block_transactions.empty()) {
+        return transactions;
+    }
+
+    transactions->reserve(block_transactions.size() - 1);
+
+    std::map<Txid, int64_t> tx_index;
+
+    int i{0};
+    for (const auto& tx_ref : block_transactions) {
+        const CTransaction& tx{*tx_ref};
+
+        const Txid tx_hash{tx.GetHash()};
+        tx_index[tx_hash] = i++;
+
+        if (tx.IsCoinBase()) {
+            continue;
+        }
+
+        UniValue deps(UniValue::VARR);
+        for (const CTxIn& in : tx.vin) {
+            if (tx_index.contains(in.prevout.hash)) {
+                deps.push_back(tx_index[in.prevout.hash]);
+            }
+        }
+
+        UniValue entry(UniValue::VOBJ);
+        entry.pushKV("data", EncodeHexTx(tx));
+        entry.pushKV("txid", tx_hash.GetHex());
+        entry.pushKV("hash", tx.GetWitnessHash().GetHex());
+        entry.pushKV("depends", std::move(deps));
+
+        const int index_in_template{i - 2};
+        entry.pushKV("fee", tx_fees.at(index_in_template));
+        entry.pushKV("sigops", tx_sigops.at(index_in_template));
+        entry.pushKV("weight", GetTransactionWeight(tx));
+
+        transactions->push_back(std::move(entry));
+    }
+
+    return transactions;
+}
