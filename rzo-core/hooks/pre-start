#!/usr/bin/env bash

APP_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
DATA_ROOT="${APP_DATA_ROOT:-${APP_DIR}/data}"
DESIRED_OWNER="1000:1000"

set_correct_permissions() {
	local -r path="${1}"

	# Check if the file exists
	if [[ -f "${path}" ]]; then
		owner=$(stat -c "%u:%g" "${path}")

		if [[ "${owner}" != "${DESIRED_OWNER}" ]]; then
			chown "${DESIRED_OWNER}" "${path}"
			echo "Changed ownership of ${path} to ${DESIRED_OWNER}"
		fi
	else
		echo "Skipping ${path} - file does not exist"
	fi
}

# We set the correct permissions for any files that may have been created by a previous app running as root:
set_correct_permissions "${DATA_ROOT}/bitcoin/umbrel-bitcoin.conf"
set_correct_permissions "${DATA_ROOT}/bitcoin/bitcoin.conf"
set_correct_permissions "${DATA_ROOT}/bitcoin/bitcoin.conf.save"
# settings.json for any network could have been self-corrected by the old app running under root.
set_correct_permissions "${DATA_ROOT}/bitcoin/settings.json"
set_correct_permissions "${DATA_ROOT}/bitcoin/regtest/settings.json"
set_correct_permissions "${DATA_ROOT}/bitcoin/signet/settings.json"
set_correct_permissions "${DATA_ROOT}/bitcoin/testnet3/settings.json"
set_correct_permissions "${DATA_ROOT}/bitcoin/testnet4/settings.json"

# Set permissions recursively on the entire /app bind directory
if [[ -d "${DATA_ROOT}/app" ]]; then
	chown -R "${DESIRED_OWNER}" "${DATA_ROOT}/app"
fi

# Initialize RZO Core settings on first install only.
# Existing user settings are never overwritten.
RZO_SETTINGS_DIR="${DATA_ROOT}/app"
RZO_SETTINGS_FILE="${RZO_SETTINGS_DIR}/settings.json"
RZO_DEFAULT_SETTINGS="${APP_DIR}/defaults/settings.json"

if [[ ! -f "${RZO_SETTINGS_FILE}" ]]; then
        mkdir -p "${RZO_SETTINGS_DIR}"
        cp "${RZO_DEFAULT_SETTINGS}" "${RZO_SETTINGS_FILE}"
        chown "${DESIRED_OWNER}" "${RZO_SETTINGS_FILE}"
        chmod 600 "${RZO_SETTINGS_FILE}"
        echo "App: ${APP_ID} - Installed initial RZO Core settings"
fi

# Install the RZO Core custom bitcoin.conf block exactly once.
# Existing user lines are preserved and never replaced.
RZO_BITCOIN_DIR="${DATA_ROOT}/bitcoin"
RZO_BITCOIN_CONF="${RZO_BITCOIN_DIR}/bitcoin.conf"
RZO_BITCOIN_DEFAULTS="${APP_DIR}/defaults/bitcoin-rzo.conf"
RZO_CONF_MARKER="# BEGIN RZO CORE MANAGED DEFAULTS"

mkdir -p "${RZO_BITCOIN_DIR}"
touch "${RZO_BITCOIN_CONF}"

if ! grep -Fq "${RZO_CONF_MARKER}" "${RZO_BITCOIN_CONF}"; then
        {
                printf "\n"
                cat "${RZO_BITCOIN_DEFAULTS}"
                printf "\n"
        } >> "${RZO_BITCOIN_CONF}"

        chown "${DESIRED_OWNER}" "${RZO_BITCOIN_CONF}"
        chmod 600 "${RZO_BITCOIN_CONF}"
        echo "App: ${APP_ID} - Installed RZO Core bitcoin.conf defaults"
fi

# Delay booting the full app until the RPC and P2P Tor Hidden Services are ready

HIDDEN_SERVICE_FILE="${TOR_DATA_DIR}/app-${APP_ID}-rpc/hostname"

if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
	exit
fi

/opt/umbreld/source/modules/apps/legacy-compat/app-script compose "${APP_ID}" up --detach app
/opt/umbreld/source/modules/apps/legacy-compat/app-script compose "${APP_ID}" up --detach tor

echo "App: ${APP_ID} - Generating Tor Hidden Service..."

for attempt in $(seq 1 100); do
	if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
		echo "App: ${APP_ID} - Hidden service file created successfully!"
		break
	fi
	sleep 0.1
done

if [[ ! -f "${HIDDEN_SERVICE_FILE}" ]]; then
	echo "App: ${APP_ID} - Hidden service file wasn't created"
fi
